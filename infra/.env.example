# Copy to infra/.env if you need to override defaults when running
# docker-compose from within the infra/ directory. The canonical example
# lives at the repo root .env.example — this file only exists for infra-local
# overrides (e.g. exposed host ports).
KAFKA_HOST_PORT=9092
ZOOKEEPER_HOST_PORT=2181
KSQLDB_HOST_PORT=8088
MLFLOW_HOST_PORT=5000
SCORING_HOST_PORT=8000
DASHBOARD_HOST_PORT=8501
