# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRANSACTIONS=pos-transactions
KAFKA_TOPIC_SCORES=pos-fraud-scores
KAFKA_TOPIC_ALERTS=pos-fraud-alerts

# ksqlDB
KSQLDB_URL=http://localhost:8088

# Spark
SPARK_MASTER=local[*]
SPARK_CHECKPOINT_DIR=/tmp/spark-checkpoints

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=pos-fraud-detection

# Scoring API
SCORING_API_HOST=0.0.0.0
SCORING_API_PORT=8000
MODEL_VERSION=v1

# Dashboard
STREAMLIT_SERVER_PORT=8501

# Excel data store (paths are relative to repo root)
DATA_DIR=data
TRANSACTIONS_XLSX=data/transactions_raw.xlsx
FEATURES_XLSX=data/features.xlsx
FRAUD_SCORES_XLSX=data/fraud_scores.xlsx
ALERTS_XLSX=data/alerts.xlsx
TERMINALS_XLSX=data/reference/terminals.xlsx
MERCHANTS_XLSX=data/reference/merchants.xlsx
